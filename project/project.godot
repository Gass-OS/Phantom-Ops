config_version=5

[application]
config/name="Phantom Ops"
config/icon="res://icon.png"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.2", "Mobile")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.07, 0.06, 0.1, 1)

[autoload]
GameManager="*res://scripts/game_manager.gd"
CampaignManager="*res://scripts/campaign_manager.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
environment/defaults/default_clear_color=Color(0.98, 0.66, 0.34, 1)
