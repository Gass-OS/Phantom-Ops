background_color = Color(0.42, 0.44, 0.55, 1)
ambient_light_source = 2
ambient_light_color = Color(0.62, 0.60, 0.58, 1)
ambient_light_energy = 0.75
tonemap_mode = 2
tonemap_exposure = 1.0
glow_enabled = false
fog_enabled = false

