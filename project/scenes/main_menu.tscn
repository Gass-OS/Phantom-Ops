theme_override_font_sizes/font_size = 22
text = "HOW TO PLAY

• Left thumb — move through Kasserine
• Right thumb — look around
• FIRE — shoot (hold for auto-fire)
• JUMP — jump, RUN — sprint
• AMMO 30/30 — it reloads automatically
• Kill enemies to score — 100 points each
• Civilians are not targets — never shoot them
• Waves get harder: 8 enemies, then more"
horizontal_alignment = 1
vertical_alignment = 1
mouse_filter = 2

